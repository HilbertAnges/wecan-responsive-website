/* CSS变量：方便统一修改颜色 */
:root {
  --primary-color: #4f46e5;
  --primary-dark: #3730a3;
  --dark-color: #172033;
  --text-color: #5c6474;
  --light-color: #f5f7ff;
  --white-color: #ffffff;
  --border-color: #dfe3ee;
}

/* 清除浏览器默认间距 */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  color: var(--dark-color);
  background: var(--white-color);
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

p {
  color: var(--text-color);
}

.container {
  width: min(1100px, 90%);
  margin: 0 auto;
}

/* 导航栏 */
.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  padding: 18px 0;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1px solid var(--border-color);
}

.nav-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  color: var(--primary-color);
  font-size: 26px;
  font-weight: bold;
  letter-spacing: 2px;
}

.nav-menu {
  display: flex;
  align-items: center;
  gap: 26px;
}

.nav-menu a:hover {
  color: var(--primary-color);
}

/* 按钮与实用类 */
.btn {
  display: inline-block;
  padding: 13px 22px;
  color: var(--white-color);
  background: var(--primary-color);
  border: 2px solid var(--primary-color);
  border-radius: 9px;
  font-weight: bold;
  transition: 0.2s;
}

.btn:hover {
  color: var(--white-color);
  background: var(--primary-dark);
  transform: translateY(-2px);
}

.btn-light {
  color: var(--primary-color);
  background: transparent;
}

.btn-small {
  padding: 9px 16px;
}

/* 手机菜单按钮，电脑端隐藏 */
.menu-button {
  display: none;
  padding: 6px 10px;
  font-size: 28px;
  background: transparent;
  border: 0;
  cursor: pointer;
}

/* 首页区域 */
.hero {
  padding: 95px 0;
  background:
    radial-gradient(circle at top right, #dfe3ff, transparent 35%),
    var(--light-color);
}

.hero-grid {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 60px;
}

.hero-text {
  flex: 1;
}

.hero h1 {
  max-width: 700px;
  margin: 12px 0 20px;
  font-size: clamp(40px, 6vw, 68px);
  line-height: 1.1;
}

.hero-text > p {
  max-width: 620px;
  font-size: 18px;
}

.label {
  color: var(--primary-color);
  font-size: 14px;
  font-weight: bold;
  letter-spacing: 2px;
}

.hero-buttons {
  display: flex;
  gap: 14px;
  margin-top: 30px;
}

.hero-picture {
  flex: 0 1 390px;
  padding: 50px 30px;
  text-align: center;
  background: var(--white-color);
  border-radius: 24px;
  box-shadow: 0 20px 55px rgba(50, 60, 100, 0.15);
}

.hero-picture span {
  display: block;
  margin-bottom: 20px;
  font-size: 90px;
}

/* 通用区域 */
.section {
  padding: 85px 0;
}

.section-heading {
  max-width: 650px;
  margin: 0 auto 42px;
  text-align: center;
}

.section-heading h2 {
  margin: 10px 0;
  font-size: 38px;
}

/* 卡片：这里使用CSS Grid */
.card-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.card {
  padding: 30px;
  background: var(--white-color);
  border: 1px solid var(--border-color);
  border-radius: 18px;
  box-shadow: 0 12px 30px rgba(30, 40, 80, 0.07);
}

.card-icon {
  margin-bottom: 15px;
  font-size: 38px;
}

.card h3 {
  margin-bottom: 10px;
}

/* 项目区域 */
.project-section {
  color: var(--white-color);
  background: var(--dark-color);
}

.project-section p {
  color: #c7ccda;
}

.project-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 70px;
  align-items: center;
}

.project-layout h2 {
  margin: 10px 0 18px;
  font-size: 40px;
}

.project-list {
  display: grid;
  gap: 15px;
}

.project-list div {
  padding: 20px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 12px;
}

.project-list strong {
  margin-right: 15px;
  color: #9fa8ff;
}

/* FAQ */
.faq-container {
  max-width: 800px;
}

.faq-item {
  margin-bottom: 14px;
  padding: 20px 24px;
  border: 1px solid var(--border-color);
  border-radius: 12px;
}

.faq-item summary {
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
}

.faq-item p {
  padding-top: 14px;
}

/* 页脚 */
.footer {
  padding: 45px 0;
  color: var(--white-color);
  background: #101827;
}

.footer p {
  color: #bbc1cf;
}

.footer-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 响应式设计：屏幕宽度小于768px时执行 */
@media (max-width: 768px) {
  .menu-button {
    display: block;
  }

  .nav-menu {
    display: none;
    position: absolute;
    top: 74px;
    right: 5%;
    left: 5%;
    flex-direction: column;
    align-items: stretch;
    padding: 24px;
    background: var(--white-color);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    box-shadow: 0 20px 40px rgba(20, 30, 60, 0.15);
  }

  .nav-menu.open {
    display: flex;
  }

  .hero {
    padding: 65px 0;
  }

  .hero-grid {
    flex-direction: column;
    text-align: center;
  }

  .hero-buttons {
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-picture {
    width: 100%;
  }

  .card-grid,
  .project-layout {
    grid-template-columns: 1fr;
  }

  .footer-content {
    flex-direction: column;
    gap: 20px;
    text-align: center;
  }
}